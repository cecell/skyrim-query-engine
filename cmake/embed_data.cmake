# Writes a C++ source that carries skqe's data files as byte arrays, for
# builds with SKQE_EMBED_DATA=ON. Run by CMake at build time:
#   cmake -DOUT=<file.cpp> -DFILES="<a>;<b>;..." -P embed_data.cmake
# Each file is looked up by its name (without the folder).
set(src "// Generated by cmake/embed_data.cmake. Do not edit.\n#include <cstddef>\n#include <string>\n\nnamespace skqe {\nnamespace {\n")
set(table "")
set(i 0)
foreach(f IN LISTS FILES)
    get_filename_component(name "${f}" NAME)
    file(READ "${f}" hex HEX)
    string(LENGTH "${hex}" hexlen)
    math(EXPR size "${hexlen} / 2")
    # 0xNN, per byte, 32 bytes per line (MSVC limits the length of a line).
    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")
    string(REGEX REPLACE "((0x[0-9a-f][0-9a-f],){32})" "\\1\n" bytes "${bytes}")
    string(APPEND src "const unsigned char kData${i}[] = {\n${bytes}0};\n")
    string(APPEND table "    if (name == L\"${name}\") { *data = kData${i}; *size = ${size}; return true; }\n")
    math(EXPR i "${i} + 1")
endforeach()
string(APPEND src "}  // namespace\n\nbool EmbeddedDataFile(const std::wstring& name, const unsigned char** data, size_t* size) {\n${table}    return false;\n}\n\n}  // namespace skqe\n")
file(WRITE "${OUT}.tmp" "${src}")
file(COPY_FILE "${OUT}.tmp" "${OUT}" ONLY_IF_DIFFERENT)
file(REMOVE "${OUT}.tmp")
